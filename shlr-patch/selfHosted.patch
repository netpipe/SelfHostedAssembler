+    jmp parse_sub
+.not_s:
     cmp al, 'c'
     je parse_cmp
     cmp al, 'x'
@@ -172,6 +177,10 @@
 parse_sub:
     call emit_alu_op
     jmp end_instr
+
+parse_shift:
+    add qword [pc_vaddr], 4   ; Assume 4 bytes for shl/shr r64, imm8
+    jmp end_instr
 
